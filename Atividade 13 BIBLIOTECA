def login():
    while True:
        try:
            ra_login = int(input("Digite seu RA: "))
            senha_login = input("Digite sua senha: ")
            cursor.execute("SELECT * FROM alunos WHERE ra=? AND senha=?", (ra_login, senha_login))
            usuario = cursor.fetchone()
            if usuario:
                print(f"Bem-vindo, {usuario[1]}!")
                return ra_login
            else:
                print("RA ou senha inválidos.")
        except ValueError:
            print("Digite apenas números para RA.")

def consultar_acervo():
    print("Consultar por: 1-Título, 2-Autor, 3-Área")
    try:
        opcao = int(input("Opção: "))
    except ValueError:
        print("Digite um número válido")
        return
    busca = input("Digite o que deseja buscar: ").strip()
    if opcao == 1:
        cursor.execute("SELECT * FROM livros WHERE titulo LIKE ?", ('%'+busca+'%',))
    elif opcao == 2:
        cursor.execute("SELECT * FROM livros WHERE autor LIKE ?", ('%'+busca+'%',))
    elif opcao == 3:
        cursor.execute("SELECT * FROM livros WHERE area LIKE ?", ('%'+busca+'%',))
    else:
        print("Opção inválida")
        return
    resultados = cursor.fetchall()
    if resultados:
        for livro in resultados:
            print(f"ID: {livro[0]} | Título: {livro[1]} | Autor: {livro[2]} | Área: {livro[3]} | Status: {livro[4]}")
        print(f"Total de livros encontrados: {len(resultados)}")
    else:
        print("Nenhum livro encontrado.")

