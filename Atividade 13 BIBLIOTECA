def devolver_livro():
    try:
        id_livro = int(input("Digite o ID do livro que deseja devolver: "))
    except ValueError:
        print("Digite um número válido")
        return
    cursor.execute("SELECT * FROM emprestimos WHERE id_livro=? AND ra_aluno=?", (id_livro, login_ra))
    emprestimo = cursor.fetchone()
    if not emprestimo:
        print("Nenhum empréstimo encontrado para esse livro e RA.")
        return
    try:
        dias = int(input("Digite a quantidade de dias de atraso (0 se não houve atraso): "))
    except ValueError:
        print("Digite apenas números")
        return
    if dias > 0:
        multa = math.ceil(dias * 2.5)
        cursor.execute("SELECT saldo_devedor FROM alunos WHERE ra=?", (login_ra,))
        saldo = cursor.fetchone()[0]
        saldo += multa
        cursor.execute("UPDATE alunos SET saldo_devedor=? WHERE ra=?", (saldo, login_ra))
        print(f"Multa de R${multa} adicionada ao seu saldo.")
    cursor.execute("UPDATE livros SET status='Disponível' WHERE id_livro=?", (id_livro,))
    cursor.execute("DELETE FROM emprestimos WHERE id_livro=? AND ra_aluno=?", (id_livro, login_ra))
    conexao.commit()
    print("Livro devolvido com sucesso.")

def pagar_multa():
    cursor.execute("SELECT saldo_devedor FROM alunos WHERE ra=?", (login_ra,))
    saldo = cursor.fetchone()[0]
    print(f"Seu saldo devedor atual é: R${saldo}")
    if saldo > 0:
        opcao = input("Deseja quitar a dívida? (s/n): ").lower()
        if opcao == 's':
            cursor.execute("UPDATE alunos SET saldo_devedor=0 WHERE ra=?", (login_ra,))
            conexao.commit()
            print("Dívida quitada.")
        else:
            print("Dívida não quitada.")
    else:
        print("Você não possui dívidas.")

